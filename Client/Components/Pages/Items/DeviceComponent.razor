@using System.Net
@using Domain.Enums
@using Domain.Models.Exceptions
@inject IJSRuntime js
@inject LocalTransferService lts
@implements IDisposable

@{
	var sendBtnClass = IsSendBtnVisible ? "" : "hidden";
}


<div class="device" tabindex="0"
	 @onclick="@(() => {
		if (lts.ReceiverIp is null)
		{
			IsSendBtnVisible = true;
		}
	 })"
	 @onfocusout="@(() => IsSendBtnVisible = false)">

	<div class="device-info-area" @ref=ElementInfo>
		<div class="icon">
			@((MarkupString)GetDeviceIcon())
		</div>

		<div class="info">
			<div class="name" @ref=ElementName>
				@Device
			</div>
			<div class="ip">
				@Device.IP
			</div>
		</div>
	</div>

	@if (lts.IsSending && (lts.ReceiverIp?.Equals(Device.IP) ?? false))
	{
		<div class="cancel-btn" @onclick="lts.StopSending">
			<i class="ph ph-x-circle"></i>
		</div>
	}

	<div class="send-btn @sendBtnClass"
		 @onclick="@(() => {
			IsSendBtnVisible = false;
			SendCallback.InvokeAsync(Device.IP);
		 })">
		<i class="ph ph-arrow-fat-line-right"></i>
	</div>
</div>

@code {
	[Parameter]
	public LocalDeviceModel Device { get; set; } = null!;

	[Parameter]
	public EventCallback<IPAddress> SendCallback { get; set; }

	public bool IsSendBtnVisible { get; set; }

	IJSObjectReference jsModule = null!;

	ElementReference ElementName;
	ElementReference ElementInfo;

	protected override void OnInitialized()
	{
		lts.SendingStopped += OnSendingStopped;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			jsModule = await js.InvokeAsync<IJSObjectReference>("import", "/js/RunningTextAnimation.js");
			await jsModule.InvokeVoidAsync("RunningTextAnimation.Init", ElementInfo, ElementName);
		}
	}

	private void OnSendingStopped(object? sender, HandledException? ex)
	{
		IsSendBtnVisible = false;
		InvokeAsync(StateHasChanged);
	}

	private string GetDeviceIcon()
	{
		return Device?.Type switch
		{
			DeviceModelType.Desktop => "<i class=\"ph ph-desktop-tower\"></i>",
			DeviceModelType.Laptop => "<i class=\"ph ph-laptop\"></i>",
			DeviceModelType.Mobile => "<i class=\"ph ph-device-mobile\"></i>",
			DeviceModelType.Tablet => "<i class=\"ph ph-device-tablet\"></i>",
			_ => "<i class=\"ph ph-question\"></i>",
		};
	}

	public void Dispose()
	{
		lts.SendingStopped -= OnSendingStopped;
	}
}
