@page "/local"
@using System.Net
@using System.Net.NetworkInformation
@using System.Net.Sockets
@using System.Text
@inject ILocalNetworkService lns
@inject INetworkInfoService nis
@inject NavigationService NavigationService
@inject LocalTransferService TransferService
@inject IStorageService StorageService
@implements IDisposable

<Header>
	<BadgeButton OnClick="@(() => NavigationService.NavigateTo("received-files"))"
				 Count="StorageService.ReceivedFiles.Count">
		<i class="ph ph-download-simple"></i>
	</BadgeButton>
	<BadgeButton OnClick="@(() => NavigationService.NavigateTo("sent-files"))"
				 Count="StorageService.SentFiles.Count">
		<i class="ph ph-upload-simple"></i>
	</BadgeButton>
	<BadgeButton OnClick="@(() => NavigationService.NavigateTo("selected-files"))"
				 Count="StorageService.SelectedFiles.Count">
		<i class="ph ph-files"></i>
	</BadgeButton>

	<RealButton Class="left" OnClick="@RefreshIPs">
		<i class="ph ph-arrows-clockwise"></i>
	</RealButton>
	<RealToggleButton IsChecked="@Listening" OnClick="@(() => Listening ? StopListening() : StartListening())">
		@if (Listening)
	<RealToggleButton IsChecked="TransferService.IsListening"
					  OnClick="@(() => TransferService.IsListening ? StopListening() : StartListening())">
		@if (TransferService.IsListening)
		{
			<i class="ph ph-ear"></i>
		}
		else
		{
			<i class="ph ph-ear-slash"></i>
		}
	</RealToggleButton>
</Header>

<div class="main">
	<div class="container">
		<div class="top-panel">
			<select class="select" @bind="SelectedIP" @bind:after="RefreshIPs">
				@foreach (var ip in NetworkInterfaceIPs)
				{
					<option value="@ip" selected="@(ip.ToString() == SelectedIP)">@ip.ToString()</option>
				}
			</select>
		</div>

		<div class="devices">
			<div class="devices-area">
				@foreach (var device in Devices)
				{
					<DeviceComponent Device="@device" SendCallback="StartSending"></DeviceComponent>
				}
			</div>
		</div>

		<div class="message">
			@Message
		</div>

	</div>
</div>

@code {
	public List<IPAddress> NetworkInterfaceIPs { get; set; } = new();

	public List<IPAddress> Gateways { get; set; } = new();

	public List<LocalDeviceModel> Devices { get; set; } = new();

	public string? SelectedIP { get; set; }

	public string? Message { get; set; }

	public bool Loading { get; set; }

	public bool Listening { get; set; }

	[CascadingParameter(Name = "MessageBox")]
	private MessageBox MessageBoxElement { get; set; } = null!;

	protected override async Task OnInitializedAsync()
	{
		TransferService.ListeningStarted += UpdateState;
		TransferService.ListeningStopped += UpdateState;

		lns.DeviceFound += OnDeviceFound;

		Message = "Getting active network interfaces...";

		await Task.Run(() =>
		{
			NetworkInterfaceIPs = nis.GetNetworkInterfaceIPAddresses();
			SelectedIP = NetworkInterfaceIPs.FirstOrDefault()?.ToString();
		});

		Message = NetworkInterfaceIPs.Count == 0
			? "Could not find active network interfaces"
			: null;

		StateHasChanged();

		if (SelectedIP is not null)
		{
			_ = lns.StartMulticastScanAsync(IPAddress.Parse(SelectedIP));
	}
	}

	private void OnDeviceFound(object? sender, LocalDeviceModel device)
	{
		if (!Devices.Exists(d => d.IP is not null && d.IP.Equals(device.IP)))
		{
			Devices.Add(device);
			StateHasChanged();
		}
	}

	private async Task RefreshIPs()
	{
		Devices.Clear();

		if (IPAddress.TryParse(SelectedIP, out var ip))
	{
			await lns.StartMulticastScanAsync(ip);
	}
	}

	private async Task StartListening()
	{
		if (!StorageService.CheckIfDirectoryWritable(StorageService.SaveFolder))
		{
			MessageBoxElement.ShowError(
				"Saving to the selected folder is not currently supported. Please select another folder.",
				"Destination folder not supported");
			return;
		}

		await TransferService.StartListeningAsync();
	}

	private async Task StopListening()
	{
		await TransferService.StopListeningAsync();
	}

	private async Task StartSending(IPAddress ip)
	{
		if (StorageService.SelectedFiles.Count == 0)
		{
			MessageBoxElement.ShowWarning("You have no files to send.");
			return;
		}

		await TransferService.StartSendingAsync(ip, new List<FileModel>(StorageService.SelectedFiles));
	}

	private void UpdateState(object? sender, EventArgs e)
	{
		InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		TransferService.ListeningStarted -= UpdateState;
		TransferService.ListeningStopped -= UpdateState;

		lns.DeviceFound -= OnDeviceFound;
	}
}
