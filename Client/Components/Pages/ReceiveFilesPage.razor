@page "/receivefiles"
@using System.Net
@using Blazored.LocalStorage
@using Client.Constants
@inject NavigationService NavigationService
@inject LocalTransferService lts
@inject GlobalTransferService gts
@inject IStorageService StorageService
@inject ILocalStorageService localStorage
@inject IJSRuntime js
@implements IDisposable

<Header>
	<RealButton OnClick="@PickFolder">
		<i class="ph ph-folder-notch"></i>
	</RealButton>
	@if (SelectedFiles.Count > 0)
	{
		<BadgeButton OnClick="@(async () => await RemoveFiles())" Count="SelectedFiles.Count">
			<i class="ph ph-trash"></i>
		</BadgeButton>
	}
	else if (StorageService.ReceiveFiles.Count > 0)
	{
		<RealButton OnClick="@(async () => await RemoveFiles(removeAll: true))">
			<i class="ph ph-broom"></i>
		</RealButton>
	}
	@if (lts.IsReceiving || gts.IsReceiving)
	{
		<RealButton OnClick="@StopReceiving">
			<i class="ph ph-x"></i>
		</RealButton>
	}
	<RealButton Class="transparent left" OnClick="@NavigationService.NavigateBack">
		<i class="ph ph-arrow-left"></i>
	</RealButton>
</Header>

<div class="container">
	<div class="folder" @ref=ElementFolderContainer>
		<div class="folder-area" @ref=ElementFolder @onclick="@PickFolder">
			@StorageService.SaveFolder
		</div>
	</div>
	<div class="files">
		@foreach (var file in StorageService.ReceiveFiles.Select((f, i) => new { File = f, Index = i }))
		{
			<FileComponent @key="file.Index + uniqueSuffix" File="@file.File" OnClick="OnFileClick"></FileComponent>
		}

		@if (StorageService.ReceiveFiles.Count == 0)
		{
			<div class="message">
				@("You haven't received any files yet")
			</div>
		}
	</div>
</div>

@code {
	[CascadingParameter(Name = "MessageBox")]
	public MessageBox MessageBoxElement { get; set; } = null!;

	private List<FileModel> SelectedFiles { get; set; } = new();

	// needed to reload animation after rerender
	private string uniqueSuffix = Guid.NewGuid().ToString();

	IJSObjectReference jsModule = null!;

	ElementReference ElementFolderContainer;
	ElementReference ElementFolder;

	protected override void OnInitialized()
	{
		lts.ReceivingStopped += OnReceivingStopped;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			jsModule = await js.InvokeAsync<IJSObjectReference>("import", "/js/RunningTextAnimation.js");
			await jsModule.InvokeVoidAsync("RunningTextAnimation.Init", ElementFolderContainer, ElementFolder);
		}
	}

	private void StopReceiving()
	{
		if (lts.IsReceiving)
		{
			lts.StopReceiving();
		}

		if (gts.IsReceiving)
		{
			gts.StopReceiving();
		}
	}

	private async Task PickFolder()
	{
		string? path = await StorageService.PickFolderAsync();

		if (path is null)
		{
			return;
		}

		if (!StorageService.CheckIfDirectoryWritable(path))
		{
			MessageBoxElement.ShowError(
				"Saving to the selected folder is not currently supported. Please select another folder.",
				"Destination folder not supported");
			return;
		}

		if (StorageService.TrySetSaveFolder(path))
		{
			StateHasChanged();
			await jsModule.InvokeVoidAsync("RunningTextAnimation.CheckAnimation", ElementFolder, ElementFolderContainer);
		}
	}

	private void OnReceivingStopped(object? sender, EventArgs e)
	{
		SelectedFiles.RemoveAll(f => !StorageService.ReceiveFiles.Contains(f));

		InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		lts.ReceivingStopped -= OnReceivingStopped;
	}

	private async Task RemoveFiles(bool removeAll = false)
	{
		if (lts.IsReceiving)
		{
			MessageBoxElement.ShowWarning("Please wait until the receiving is complete.");
			return;
		}

		if (removeAll)
		{
			StorageService.ReceiveFiles.Clear();
			await localStorage.RemoveItemAsync(LocalStorageConstants.SendFilesKey);
		}
		else
		{
			foreach (FileModel f in SelectedFiles)
			{
				StorageService.ReceiveFiles.Remove(f);
			}

			await localStorage.SetItemAsync<SynchronizedCollection<FileModel>>(LocalStorageConstants.SendFilesKey, StorageService.SendFiles);
		}

		SelectedFiles.Clear();
		uniqueSuffix = Guid.NewGuid().ToString();
	}

	private void OnFileClick(FileModel file)
	{
		if (SelectedFiles.Contains(file))
		{
			SelectedFiles.Remove(file);
		}
		else
		{
			SelectedFiles.Add(file);
		}
	}
}
