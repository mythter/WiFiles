@using UIComponents.Models
@inject IJSRuntime js

@{
	string isVisible = Model.IsVisible ? "appearing" : "hidden disappearing";
}

<div class="message-container @isVisible" @onclick="@(() => { if (!Model.IsModal) Close(); } )" @ref="ElementContainer" @onclick:stopPropagation="true">
	<div class="message" @onclick:stopPropagation="true">
		<div class="title">
			<div class="title-icon @GetTitleClass()">
				@((MarkupString)GetTitleIcon())
			</div>
			<div class="title-text">
				@Model.Title
			</div>
		</div>
		<div class="message-text-area">
			<div class="message-text">
				@((MarkupString?)(Model.Message ?? ""))
			</div>
		</div>
		<div class="buttons">
			@if (Model.ButtonsCount == 2)
			{
				<div class="button" @onclick="@(() => OnClickResult(true))">
					Yes
				</div>
				<div class="button" @onclick="@(() => OnClickResult(false))">
					No
				</div>
			}
			else
			{
				<div class="button" @onclick="Close">
					Ok
				</div>
			}
		</div>
	</div>
</div>

@code {
	IJSObjectReference jsModule = null!;

	[Parameter]
	public required MessageBoxModel Model { get; set; }

	[Parameter] 
	public EventCallback<bool> OnResult { get; set; }

	[Parameter]
	public EventCallback OnClose { get; set; }

	ElementReference ElementContainer;

	private TaskCompletionSource<bool>? taskCompletionSource;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			jsModule = await js.InvokeAsync<IJSObjectReference>("import", "./_content/UIComponents/Components/MessageBox/MessageBox.razor.js");
			await jsModule.InvokeVoidAsync("MessageBox.Init", DotNetObjectReference.Create(this), ElementContainer);
		}
	}

	private void OnClickResult(bool result)
	{
		SetResult(result);
		Close();
	}

	private void Close()
	{
		if (taskCompletionSource is not null)
			SetResult(false);

		Model.IsVisible = false;
		StateHasChanged();
	}

	private void SetResult(bool result)
	{
		_ = OnResult.InvokeAsync(result);

		taskCompletionSource?.SetResult(result);
		taskCompletionSource = null;
	}

	[JSInvokable]
	public void CloseAfterAnimation()
	{
		OnClose.InvokeAsync();
	}

	private string GetTitleIcon()
	{
		return Model.Type switch
		{
			MessageType.Info => "<i class=\"ph ph-info\"></i>",
			MessageType.Warning => "<i class=\"ph ph-warning\"></i>",
			MessageType.Error => "<i class=\"ph ph-seal-warning\"></i>",
			MessageType.Request => "<i class=\"ph ph-question\"></i>",
			_ => "<i class=\"ph ph-info\"></i>",
		};
	}

	private string GetTitleClass()
	{
		return Model.Type switch
		{
			MessageType.Info => "info",
			MessageType.Warning => "warning",
			MessageType.Error => "error",
			MessageType.Request => "request",
			_ => "",
		};
	}
}
